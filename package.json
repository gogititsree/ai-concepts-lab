{
  "name": "ai-concepts-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm -r --parallel run dev",
    "setup:env": "node scripts/setup-env.mjs",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.e2e.json",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:coverage": "pnpm -r run test:coverage",
    "pretest:e2e": "node scripts/e2e-db.mjs",
    "test:e2e": "pnpm run pretest:e2e && playwright test",
    "db:up": "docker compose -f docker/docker-compose.yml up -d --wait postgres",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "obs:up": "docker compose --env-file .env -f docker/docker-compose.yml --profile observability up -d",
    "obs:down": "docker compose --env-file .env -f docker/docker-compose.yml --profile observability down",
    "obs:logs": "docker compose --env-file .env -f docker/docker-compose.yml --profile observability logs -f",
    "db:generate": "pnpm --filter api run db:generate",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:seed": "pnpm --filter @lab/shared run build && pnpm --filter api run db:seed",
    "db:studio": "pnpm --filter api run db:studio",
    "test:integration": "pnpm --filter api run test:integration",
    "test:coverage:gate": "pnpm --filter api run test:coverage:gate",
    "content:embeddings": "pnpm --filter @lab/shared run build && node apps/api/scripts/generate-embeddings.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:integration",
    "dev:only": "pnpm -r --parallel run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
