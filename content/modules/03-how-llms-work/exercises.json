[
  {
    "slug": "tokens-embeddings-attention",
    "title": "Tokens, embeddings and attention",
    "kind": "tokenizer",
    "orderIndex": 1,
    "lessonSlug": "text-to-tokens-bpe",
    "config": {
      "tabs": ["tokenizer", "embeddings", "attention"],
      "tokenizer": {
        "corpusFile": "corpus.txt",
        "mergeRange": [50, 500],
        "defaultMerges": 200,
        "defaultText": "tokens are the unit of money and the unit of memory",
        "sampleSentences": [
          {
            "id": "in-domain",
            "text": "the tokenizer counted every pair of symbols in the training text"
          },
          {
            "id": "out-of-domain",
            "text": "zebras waltz quixotically through the fog"
          },
          {
            "id": "digits-and-symbols",
            "text": "strawberry jam costs 1234567890 dollars a jar"
          }
        ]
      },
      "embeddings": {
        "fallbackFile": "embeddings-precomputed.json",
        "neighbourCount": 3,
        "defaultAnalogy": { "a": "king", "b": "man", "c": "woman" },
        "words": [
          { "word": "cat", "cluster": "animals" },
          { "word": "dog", "cluster": "animals" },
          { "word": "horse", "cluster": "animals" },
          { "word": "wolf", "cluster": "animals" },
          { "word": "tiger", "cluster": "animals" },
          { "word": "mouse", "cluster": "animals" },
          { "word": "rabbit", "cluster": "animals" },
          { "word": "eagle", "cluster": "animals" },
          { "word": "salmon", "cluster": "animals" },
          { "word": "bear", "cluster": "animals" },
          { "word": "france", "cluster": "countries" },
          { "word": "germany", "cluster": "countries" },
          { "word": "japan", "cluster": "countries" },
          { "word": "brazil", "cluster": "countries" },
          { "word": "canada", "cluster": "countries" },
          { "word": "egypt", "cluster": "countries" },
          { "word": "india", "cluster": "countries" },
          { "word": "norway", "cluster": "countries" },
          { "word": "run", "cluster": "verbs" },
          { "word": "walk", "cluster": "verbs" },
          { "word": "jump", "cluster": "verbs" },
          { "word": "swim", "cluster": "verbs" },
          { "word": "write", "cluster": "verbs" },
          { "word": "read", "cluster": "verbs" },
          { "word": "sing", "cluster": "verbs" },
          { "word": "sleep", "cluster": "verbs" },
          { "word": "one", "cluster": "numbers" },
          { "word": "two", "cluster": "numbers" },
          { "word": "three", "cluster": "numbers" },
          { "word": "four", "cluster": "numbers" },
          { "word": "five", "cluster": "numbers" },
          { "word": "six", "cluster": "numbers" },
          { "word": "seven", "cluster": "numbers" },
          { "word": "eight", "cluster": "numbers" },
          { "word": "king", "cluster": "people" },
          { "word": "queen", "cluster": "people" },
          { "word": "prince", "cluster": "people" },
          { "word": "princess", "cluster": "people" },
          { "word": "man", "cluster": "people" },
          { "word": "woman", "cluster": "people" },
          { "word": "boy", "cluster": "people" },
          { "word": "girl", "cluster": "people" }
        ]
      },
      "attention": {
        "words": ["the", "cat", "sat", "on", "the", "mat", "because", "it"],
        "dk": 3,
        "dimensionLabels": ["thing", "place", "glue"],
        "defaultTemperature": 1,
        "defaultScale": true,
        "Q": [
          [0.2, 0.2, 2.0],
          [1.6, 0.4, 0.2],
          [1.8, 1.4, 0.0],
          [0.4, 2.2, 0.2],
          [0.2, 0.2, 2.0],
          [1.4, 0.6, 0.4],
          [0.8, 0.8, 1.6],
          [2.4, 2.4, -0.8]
        ],
        "K": [
          [0.1, 0.0, 1.0],
          [1.0, 0.1, 0.0],
          [0.2, 0.6, 0.1],
          [0.0, 0.9, 0.8],
          [0.1, 0.0, 1.0],
          [0.9, 1.0, 0.0],
          [0.0, 0.1, 0.9],
          [0.5, 0.4, 0.3]
