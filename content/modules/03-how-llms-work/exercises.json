        "V": [
          [0.0, 0.0, 0.2],
          [1.0, 0.0, 0.0],
          [0.0, 0.6, 0.1],
          [0.0, 0.5, 0.3],
          [0.0, 0.0, 0.2],
          [0.7, 0.9, 0.0],
          [0.0, 0.1, 0.8],
          [0.3, 0.3, 0.3]
        ]
      },
      "reflectionMd": "Three tabs, one pipeline. Write down the token count your favourite sentence had at 50 merges and at 500, and then the thing that is easy to miss: the attention weights for **it** never became a one-hot. Even at the sharpest setting the row still spends a fifth of its mass elsewhere. A model that could only look at one word would be a lookup table.",
      "tasks": [
        {
          "id": "tokenize-three",
          "label": "Tokenize all three sample sentences, then say which one costs the most tokens",
          "hintMd": "Use the three buttons above the text area. The count is in the stats row; the answer does not change as you move the merge slider, which is itself worth noticing.",
          "check": {
            "kind": "tokenize",
            "sentencesTokenized": 3,
            "answerSentenceId": "digits-and-symbols"
          }
        },
        {
          "id": "find-neighbour",
          "label": "Find the nearest word to \"wolf\" by cosine similarity",
          "hintMd": "Click **wolf** in the scatter, then click a second word to read the cosine. The nearest-words list under the analogy box ranks them for you.",
          "check": { "kind": "neighbour", "targetWord": "wolf", "acceptable": ["dog"] }
        },
        {
          "id": "attention-row",
          "label": "Read the attention row for \"it\" and pick the word it attends to most",
          "hintMd": "Row 8 of the heatmap, or hover **it** and watch the arcs. One key gets nearly half the row.",
          "check": { "kind": "attention-row", "queryIndex": 7, "expectedKeyIndex": 5 }
        }
      ]
    },
    "completionRule": { "type": "tasks", "required": 2 }
  }
]
