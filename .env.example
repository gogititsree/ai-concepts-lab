# Copy to .env and adjust. Only the API reads these; the web app reads nothing at runtime.

# development | test | production
NODE_ENV=development
# Port the Fastify API listens on (the Vite dev server proxies /api here).
PORT=3000
# 0.0.0.0 so the app is reachable from inside a container.
HOST=0.0.0.0
# Build provenance: surfaced as `version` by GET /api/v1/health.
GIT_SHA=dev
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres connection string. Required: the API refuses to start without it.
# `pnpm db:up` starts the compose service these credentials match.
DATABASE_URL=postgres://lab:lab@localhost:5432/lab
# Maximum connections postgres.js will open. Keep it small: managed Postgres free tiers
# (Neon) count connections, and that allowance is shared with the pre-deploy migration
# job and any psql session. Three is what the deployment runs (see render.yaml).
DB_POOL_MAX=3

# --- Auth (M5) ---------------------------------------------------------------
# HMAC key for signing the `sid` session cookie. At least 32 characters; required in
# production, where the API refuses to boot without it. `pnpm setup:env` generates one:
# leave it empty here and the script fills it in your .env.
SESSION_SECRET=
# Origin the browser loads the SPA from. Non-GET requests that carry an `Origin` header
# must match it (CSRF defence). Dev = the Vite dev server; prod = the deployed URL.
APP_ORIGIN=http://localhost:5173
# `Secure` flag on the session cookie. Must be false over plain http://localhost,
# otherwise the browser drops the cookie and every request looks unauthenticated.
COOKIE_SECURE=false
# Trust X-Forwarded-* headers. Only true behind a real proxy (Render); otherwise any
# client could spoof its IP and slip past the per-IP rate limits.
TRUST_PROXY=false

# --- MFA (M6) ----------------------------------------------------------------
# AES-256-GCM key protecting the TOTP secret at rest. Exactly 32 bytes, given as 64 hex
# characters or 44 base64 characters. Required in production. Losing or rotating it makes
# every enrolled authenticator undecryptable, so it is not the same key as SESSION_SECRET.
# `pnpm setup:env` generates one: leave it empty here and the script fills your .env.
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# --- Maintenance (M13) --------------------------------------------------------
# Bearer token for POST /api/v1/ops/maintenance. Locally you do not need one: the API
# runs the same housekeeping on an hourly in-process timer. In production a scheduled
# GitHub Actions workflow calls the endpoint instead, because a sleeping free instance
# runs no timers. At least 32 characters; leave it empty and the endpoint answers 503.
#   openssl rand -base64 36
MAINTENANCE_TOKEN=

# --- Observability (M14) ------------------------------------------------------
# Bearer token for GET /metrics. Without it the endpoint answers 503 rather than
# serving unauthenticated: a metrics page is a free inventory of every route, error
# code and traffic volume in the service. At least 24 characters; `pnpm setup:env`
# generates one.
#   openssl rand -base64 27
# The local Prometheus reads the same value: `pnpm obs:up` passes the repo-root .env
# to compose, which hands it to the container as a secret.
METRICS_TOKEN=

# --- Model provider (M9) ------------------------------------------------------
# Which ModelProvider implementation the API builds:
#   ollama - the real local model (default in development)
#   fake   - deterministic scripted responses; what every test and CI run uses
#   none   - no model: /model/* returns 503 MODEL_UNAVAILABLE and the UI shows the
#            "run this locally" banner. This is what the Render deployment runs.
# Defaults to `ollama` in development and `none` everywhere else.
MODEL_PROVIDER=ollama
# Where Ollama listens. Never sent to a client: GET /model/health does not echo it.
OLLAMA_BASE_URL=http://localhost:11434
# gemma4:latest, not the gemma4:e4b named in the original design docs -- e4b is not
# installed on this machine and every measurement in docs/spike-notes.md used :latest.
OLLAMA_CHAT_MODEL=gemma4:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
# Per-call ceiling. Measured, not guessed: warm calls take 6-45 s on this hardware and a
# cold model load adds 20-40 s, so anything much under 90 s fails the first call of the day.
MODEL_TIMEOUT_MS=90000
